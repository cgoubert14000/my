# --- Meta / Facebook ---
# Le bot est verrouillé sur cette Page. Le nom est contrôlé avant tout envoi.
FACEBOOK_EXPECTED_PAGE_NAME=Madame Portugais
# Identifiant numérique de la Page Madame Portugais (pas celui du profil personnel)
FACEBOOK_PAGE_ID=1098568206676051
# Jeton d'accès DE CETTE PAGE. Ne le partagez jamais et ne le commitez pas.
FACEBOOK_PAGE_ACCESS_TOKEN=collez_votre_jeton_de_page_ici
# Utilisez une version encore prise en charge par votre application Meta.
FACEBOOK_API_VERSION=v26.0

# --- Planning ---
BOT_TIMEZONE=Europe/Paris
# Exactement 3 plages, au format HH:MM-HH:MM.
# Une heure aléatoire est choisie chaque jour dans chacune des 3 plages.
POSTING_WINDOWS=07:00-10:00,12:00-15:00,18:00-22:00

# --- Images ---
IMAGE_DIR=images/to_post
ARCHIVE_DIR=images/posted
# oldest | alphabetical | random
QUEUE_ORDER=oldest
# Utilisé uniquement lorsqu'aucun fichier .txt n'accompagne l'image.
DEFAULT_CAPTION=

# --- Fonctionnement ---
STATE_DB=data/facebook_bot.sqlite3
POLL_INTERVAL_SECONDS=15
EMPTY_QUEUE_RECHECK_MINUTES=5
RETRY_INTERVAL_MINUTES=10
MAX_POST_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=120
