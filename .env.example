# ============================================================================
#  arbbot — configuration (copier en .env puis adapter). AUCUN SECRET ICI.
#  Les clés privées ne vont JAMAIS dans ce fichier : voir docs/06_wallet_securise.md
# ============================================================================

# --- Réseau -------------------------------------------------------------------
# local = devnet anvil (par défaut, sans risque) | base | arbitrum
ARB_CHAIN=local
# RPC HTTP (obligatoire). Exemples : Alchemy/Infura/QuickNode/dRPC ou votre propre nœud.
#   Base     : https://base-mainnet.g.alchemy.com/v2/VOTRE_CLE   ou  https://mainnet.base.org (public, limité)
#   Arbitrum : https://arb-mainnet.g.alchemy.com/v2/VOTRE_CLE   ou  https://arb1.arbitrum.io/rpc
ARB_RPC_HTTP_URL=http://127.0.0.1:8545
# RPC WebSocket (optionnel : abonnements newHeads ; sinon sondage HTTP toutes les ARB_POLL_INTERVAL_S)
ARB_RPC_WS_URL=
# RPC de secours, séparés par des virgules (bascule automatique en cas d'erreur)
ARB_RPC_FALLBACK_HTTP_URLS=
ARB_RPC_TIMEOUT_S=10
# Limite côté client (req/s) : adaptez au forfait du fournisseur (gratuit ≈ 10–25 req/s)
ARB_RPC_MAX_RPS=20
ARB_POLL_INTERVAL_S=1.0

# --- API / interface ------------------------------------------------------------
ARB_API_HOST=0.0.0.0
ARB_API_PORT=8000
ARB_API_CORS_ORIGINS=*
ARB_LOG_LEVEL=INFO

# --- Contrat exécuteur -----------------------------------------------------------
# Adresse du FlashArbExecutor déployé par VOUS (vide = simulation uniquement via stateOverride, aucune exécution réelle possible)
ARB_EXECUTOR_ADDRESS=
ARB_SIMULATE_WITH_STATE_OVERRIDE=true

# --- Politique d'autorisation financière (fichier séparé, jamais modifié par le moteur) ---
ARB_POLICY_PATH=authorization.json

# --- Signer isolé (processus séparé) ----------------------------------------------
# Le moteur ne connaît que l'URL et un jeton partagé ; la clé reste dans le processus signer.
ARB_SIGNER_URL=http://127.0.0.1:8787
# Jeton aléatoire long (ex. : python -c "import secrets;print(secrets.token_hex(32))") — à mettre AUSSI dans l'environnement du signer
ARB_SIGNER_TOKEN=
# Variables lues UNIQUEMENT par le processus signer (arbbot signer) :
#   ARB_SIGNER_KEYSTORE=keystores/executor.json       (créé par : arbbot make-keystore)
#   ARB_SIGNER_KEYSTORE_PASSWORD=                      (sinon demandé au clavier au démarrage — recommandé)
#   ARB_SIGNER_HOST=127.0.0.1  ARB_SIGNER_PORT=8787  ARB_SIGNER_STATE=data/signer_state.json

# --- Affichage --------------------------------------------------------------------
ARB_EUR_PER_USD=0.92
ARB_NATIVE_USD_FALLBACK=0
